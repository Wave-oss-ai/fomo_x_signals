# Copy this file to .env and fill in your own keys. Never commit .env.

# --- PumpPortal (Solana pump.fun-style graduation feed) ---
# Free to read new-token + migration ("graduation") events.
# Get a key at https://pumpportal.fun (an account is required even for the free streams).
PUMPPORTAL_API_KEY=

# --- X (Twitter) API v2 ---
# As of 2026 X has no free tier: reads are billed per-call (~$0.005/tweet read).
# Get a Bearer Token at https://developer.x.com after creating a paid project.
# If you'd rather use a cheaper third-party reseller (e.g. GetXAPI, TwitterAPI.io,
# Xpoz), sign up there instead and adjust twitter_scanner.py's request/parsing
# to match that provider's docs -- the rest of this project doesn't care where
# the tweets came from.
X_BEARER_TOKEN=

# --- Behavior tuning ---
# How long (minutes) to keep polling X for mentions of a token after it graduates.
# Keeps API spend bounded instead of polling forever.
MENTION_WATCH_WINDOW_MIN=120
# How often (seconds) to poll X for each actively-watched token.
MENTION_POLL_INTERVAL_SEC=90
# Mentions in the watch window needed before we call a token "high attention".
ATTENTION_MENTION_THRESHOLD=8
